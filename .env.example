# ==============================================================================
# ORIAN AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your secret credentials.
# NEVER commit .env to public version control repositories.
# ==============================================================================

# --- Master Cryptographic Keys ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ORIAN_SECRET_KEY=replace_with_a_64_character_hex_secret_key_for_jwt_and_hmac
ORIAN_ENCRYPTION_KEY=replace_with_a_64_character_hex_encryption_key_for_aes_gcm

# --- Server & Network ---
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENV=production

# --- LLM Providers & API Keys ---
DEFAULT_PROVIDER=local
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-chat-hf

# --- Voice & Sensory Services ---
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# --- MQTT IoT Broker ---
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Security Defaults ---
AUTH_ENABLED=true
MFA_ENABLED=true
DEFAULT_RISK_POLICY=strict
REQUIRE_CONFIRMATION_FOR_HIGH_RISK=true
REQUIRE_MFA_FOR_CRITICAL=true
SELF_PROGRAMMING_ENABLED=true
SELF_PROGRAMMING_REQUIRES_OWNER=true
